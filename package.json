{
  "name": "proyecto-qa-tienda",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas - Grupo 4 - Variante 1 (LambdaTest E-commerce Playground)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
